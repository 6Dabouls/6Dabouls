# ─────────────────────────────────────────
# MIDAS INVEST — Configuration serveur
# Copiez ce fichier en .env et remplissez
# ─────────────────────────────────────────

PORT=3000
NODE_ENV=development

# Clé secrète JWT (changez en production)
JWT_SECRET=midas_secret_change_me_in_production

# Base de données SQLite
DB_PATH=./db/midas.db

# Admin
ADMIN_EMAIL=sergedaboulejunior@gmail.com

# ── Campay (Mobile Money Cameroun) ────────
# Créez un compte sur https://campay.net
# Environnement : sandbox | prod
CAMPAY_ENV=sandbox
CAMPAY_USERNAME=your_campay_username
CAMPAY_PASSWORD=your_campay_password

# URL du serveur (pour les webhooks Campay)
APP_URL=http://localhost:3000
